{
  "name": "chart-crochet-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Tiệm Len Xinh - Crochet Chart & Accessories Management Platform (NestJS + React Vite + MongoDB)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run start:dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
